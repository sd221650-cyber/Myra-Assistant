<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="70dp" android:height="70dp"/>
            <stroke android:width="3dp" android:color="#00E5FF" android:dashWidth="8dp" android:dashGap="4dp" />
            <solid android:color="#CC0B132B" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#7000FF" />
        </shape>
    </item>
</layer-list>
